# Server configuration
PORT=5000
NODE_ENV=development

# Security: 32-byte hex key for AES-256-GCM API key encryption
# Generate in production via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Session secret for cookie signature
SESSION_SECRET=dev_session_secret_change_in_production_min_32_chars

# Database file location
DATABASE_PATH=./data/nexora.db

# Frontend origin allowed in CORS (leave blank or specify http://localhost:5173 for dev)
CORS_ORIGIN=http://localhost:5173

# Optional: Advertising configuration toggle (disabled by default)
ADS_ENABLED=false
ADS_PROVIDER=none
