# ==============================================================================
# NEXORA AI - Environment Configuration Template
# NOTE: Never commit production values or real API keys to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Security: 32-byte hex key (64 characters) for AES-256-GCM encryption of BYOK keys at rest.
# In production, this MUST be generated securely, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server will refuse to start in production if this is missing or using default placeholders.
ENCRYPTION_KEY=YOUR_64_CHAR_HEX_ENCRYPTION_KEY_HERE_GENERATE_WITH_CRYPTO_RANDOMBYTES

# Session secret for cookie integrity (Minimum 32 characters in production)
# In production, this MUST be a cryptographically strong secret.
SESSION_SECRET=YOUR_MIN_32_CHAR_SESSION_SECRET_HERE_CHANGE_IN_PRODUCTION

# Database file location (SQLite WAL mode) or connection string for PostgreSQL
DATABASE_PATH=./data/nexora.db

# CORS Allowed Origins (Comma-separated list of allowed origins)
# In production, this MUST be set to your exact front-end domain(s) (e.g., https://nexora.ai,https://app.nexora.ai).
# In development, defaults to http://localhost:5173,http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# Optional: Advertising configuration toggle (disabled by default)
ADS_ENABLED=false
ADS_PROVIDER=none
